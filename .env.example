# Macumba Shop — variables de entorno
# Copia este archivo como .env y ajusta si hace falta:  cp .env.example .env

# Base de datos SQLite (la ruta relativa se resuelve desde prisma/schema.prisma)
# Alternativa: usa la ruta absoluta de tu proyecto, ej. file:/Users/tu/macumba-shop/db/custom.db
DATABASE_URL="file:../db/custom.db"

# Número oficial de WhatsApp (código de país + número, sin "+" ni espacios)
# Se usa en todos los botones wa.me de la tienda
NEXT_PUBLIC_WHATSAPP_NUMBER=573204959889
