# Macumba Shop — variables de entorno
# Copia este archivo como .env y ajusta si hace falta:  cp .env.example .env

# Base de datos SQLite (la ruta relativa se resuelve desde prisma/schema.prisma)
# Alternativa: usa la ruta absoluta de tu proyecto, ej. file:/Users/tu/macumba-shop/db/custom.db
DATABASE_URL="file:../db/custom.db"

# Número oficial de WhatsApp (código de país + número, sin "+" ni espacios)
# Se usa en todos los botones wa.me de la tienda
NEXT_PUBLIC_WHATSAPP_NUMBER=573204959889

# --- WhatsApp Cloud API (Fase 0 - automatizacion) ---
# Token de acceso de Meta (temporal 24h en pruebas; permanente para produccion)
WHATSAPP_TOKEN=
# Phone Number ID que Meta muestra en API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Cadena secreta para validar el webhook (inventala tu, ej: macumba-shop-verify-2026)
WHATSAPP_VERIFY_TOKEN=macumba-shop-verify
# Numero interno que recibe los avisos de pedidos (Robert), con indicativo y sin "+"
WHATSAPP_NOTIFY_TO=573204959889
# URL publica de la tienda (para los enlaces dentro de los mensajes)
NEXT_PUBLIC_SITE_URL=https://macumba-shop.vercel.app
