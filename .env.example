# ============================================================
# MACUMBA SHOP — Variables de entorno (TEMPLATE)
# Copia este archivo a .env.local y completa con tus valores reales.
# NUNCA commitees .env.local
# ============================================================

# ---------- Supabase ----------
# URL pública del proyecto (no secreta). Se encuentra en:
# Supabase Dashboard → Project Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Clave ANON pública (RLS la usa). Se encuentra en:
# Supabase Dashboard → Project Settings → API → "Project API keys" → "anon public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave SERVICE ROLE — SECRETA, solo server-side (API routes, Server Components).
# Tiene acceso total a la BD saltándose RLS. JAMÁS exponer al cliente.
# Se encuentra en: Project Settings → API → "Project API keys" → "service_role"
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------- WhatsApp (Colombia) ----------
# Número de WhatsApp Business de MACUMBA SHOP en formato internacional:
# 57 (país) + 10 dígitos del móvil (sin el 9 adicional, sin + ni espacios).
# Ejemplo: 573204959889
NEXT_PUBLIC_WHATSAPP_NUMBER=573204959889

# ---------- Sitio ----------
# URL pública del sitio cuando esté en producción (Vercel).
# Se usa para generar enlaces absolutos en mensajes de WhatsApp y OG metadata.
NEXT_PUBLIC_SITE_URL=https://macumbashop.com

# ---------- Supabase Storage ----------
# Buckets creados manualmente en Supabase Dashboard → Storage.
NEXT_PUBLIC_SUPABASE_BUCKET_MOCKUPS=mockups
NEXT_PUBLIC_SUPABASE_BUCKET_DESIGN_ASSETS=design-assets
NEXT_PUBLIC_SUPABASE_BUCKET_USER_UPLOADS=user-uploads
NEXT_PUBLIC_SUPABASE_BUCKET_ORDER_PREVIEWS=order-previews
