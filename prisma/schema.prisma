generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Catálogo "La Sala" de Macumba Shop
// kind: 'unica' = pieza terminada pintada a mano | 'personalizable' = silueta base de El Taller
model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  category      String // chaqueta | abrigo | otra
  gender        String // femenino | masculino | unisex
  kind          String   @default("unica")
  basePrice     Int // COP
  sizes         String // "S,M,L,XL"
  description   String
  technique     String // Pintura textil | Bordado a mano | ...
  material      String // Denim reciclado | Lana reciclada | ...
  imageUrl      String // foto de catálogo (fondo blanco)
  heroImageUrl  String? // foto editorial (fondo lino) para la secuencia del hero
  serieLabel    String? // "SELVA VIVA · 01/04"
  isFeatured    Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("products")
}
